 .table-responsive{border-radius:12px}.table>thead{position:sticky;top:0;z-index:2}.btn-primary{background:#174ea6;border-color:#174ea6}
+/* ERP Workspace UI */
+.erp-workspace-tabs{position:sticky;top:0;z-index:900;display:flex;align-items:center;gap:6px;overflow-x:auto;background:#e8eef7;border:1px solid var(--border);border-radius:12px 12px 0 0;padding:6px 8px;margin:0 0 12px;scrollbar-width:thin}
+.erp-workspace-tab{display:inline-flex;align-items:center;gap:7px;min-width:120px;max-width:230px;padding:8px 10px;background:#f8fafc;border:1px solid #d8e0eb;border-radius:9px;color:#475569;text-decoration:none;white-space:nowrap;cursor:pointer}
+.erp-workspace-tab.active{background:#fff;color:var(--primary);border-color:#9bb8e8;box-shadow:0 3px 10px rgba(15,23,42,.08)}
+.erp-workspace-tab .tab-title{overflow:hidden;text-overflow:ellipsis}.erp-workspace-tab .tab-close{border:0;background:transparent;color:#94a3b8;font-size:16px;line-height:1;padding:0}.erp-workspace-tab .tab-close:hover{color:#b91c1c}
+.erp-workspace-tools{display:flex;gap:5px;margin-inline-start:auto;position:sticky;left:0}.erp-workspace-tools button{border:1px solid #d8e0eb;background:#fff;border-radius:8px;padding:6px 9px}
+.erp-command-bar{display:grid;grid-template-columns:minmax(260px,1fr) auto;gap:8px;align-items:center;margin:0 0 14px}.erp-command-bar #global-search-form{margin:0!important}.erp-command-actions{display:flex;gap:6px}
+.erp-page-title,.d-flex.justify-content-between.align-items-center.mb-4{background:#fff;border:1px solid var(--border);border-radius:14px;padding:14px 16px;box-shadow:0 4px 18px rgba(15,23,42,.05)}
+.form-card{box-shadow:0 4px 18px rgba(15,23,42,.055)}
+.table tbody tr{transition:.12s}.table tbody tr:hover{background:#f7faff}.table td,.table th{vertical-align:middle}
+.erp-context-menu{position:fixed;display:none;min-width:220px;background:#fff;border:1px solid #d8e0eb;border-radius:11px;box-shadow:0 14px 35px rgba(15,23,42,.2);padding:6px;z-index:99999}.erp-context-menu.show{display:block}.erp-context-menu button{display:flex;width:100%;gap:8px;align-items:center;border:0;background:transparent;text-align:right;padding:9px 10px;border-radius:7px}.erp-context-menu button:hover{background:#eef4ff}.erp-context-menu hr{margin:5px 0;border-color:#e2e8f0}.erp-context-menu .danger{color:#b91c1c}
+.erp-statusbar{position:fixed;bottom:0;left:0;right:var(--sidebar-width);height:26px;background:#fff;border-top:1px solid var(--border);display:flex;align-items:center;justify-content:space-between;padding:0 16px;font-size:11px;color:#64748b;z-index:800}.content{padding-bottom:42px}
+@media(max-width:900px){.erp-workspace-tabs{position:relative}.erp-command-bar{grid-template-columns:1fr}.erp-command-actions{display:none}.erp-statusbar{right:0}.erp-page-title,.d-flex.justify-content-between.align-items-center.mb-4{align-items:flex-start!important;gap:10px;flex-wrap:wrap}}
+@media print{.erp-workspace-tabs,.erp-command-bar,.erp-statusbar,.erp-context-menu{display:none!important}}
@@
