 </main>
+{% if session.get('user_id') %}<div class="erp-statusbar no-print"><span>West ERP • مساحة العمل</span><span id="erpOpenCount"></span></div><div id="erpGlobalContextMenu" class="erp-context-menu no-print"></div>{% endif %}
@@
 function toggleSidebar(){document.getElementById("erpSidebar")?.classList.toggle("open");}
+const ERP_WORKSPACE_KEY='west_erp_workspace_v1';
+function erpCleanUrl(value){try{const u=new URL(value,location.origin);return u.pathname+u.search}catch(e){return value}}
+function erpPageTitle(){const h=document.querySelector('h1,h2,h3,h4');return (h?.textContent||document.title||'شاشة').trim().replace(/\s+/g,' ').slice(0,55)}
+function erpLoadTabs(){try{return JSON.parse(sessionStorage.getItem(ERP_WORKSPACE_KEY)||'[]')}catch(e){return []}}
+function erpSaveTabs(tabs){sessionStorage.setItem(ERP_WORKSPACE_KEY,JSON.stringify(tabs.slice(-12)))}
+function erpRememberPage(){if(!document.getElementById('erpWorkspaceTabs'))return;const url=erpCleanUrl(location.href);if(['/login','/logout'].includes(location.pathname))return;let tabs=erpLoadTabs().filter(t=>t.url!==url);tabs.push({url,title:erpPageTitle(),ts:Date.now()});erpSaveTabs(tabs);erpRenderTabs()}
+function erpRenderTabs(){const bar=document.getElementById('erpWorkspaceTabs');if(!bar)return;const current=erpCleanUrl(location.href),tabs=erpLoadTabs();bar.innerHTML='';tabs.forEach(t=>{const a=document.createElement('a');a.className='erp-workspace-tab'+(t.url===current?' active':'');a.href=t.url;a.dataset.erpTab='1';a.innerHTML='<span class="tab-title"></span><button type="button" class="tab-close" aria-label="إغلاق">×</button>';a.querySelector('.tab-title').textContent=t.title;a.querySelector('.tab-close').onclick=e=>{e.preventDefault();e.stopPropagation();erpCloseTab(t.url)};bar.appendChild(a)});const tools=document.createElement('div');tools.className='erp-workspace-tools';tools.innerHTML='<button type="button" title="إغلاق الشاشات الأخرى">إغلاق الباقي</button>';tools.firstChild.onclick=()=>{erpSaveTabs(tabs.filter(t=>t.url===current));erpRenderTabs()};bar.appendChild(tools);const c=document.getElementById('erpOpenCount');if(c)c.textContent=tabs.length+' شاشة مفتوحة'}
+function erpCloseTab(url){let tabs=erpLoadTabs(),was=erpCleanUrl(location.href)===url;tabs=tabs.filter(t=>t.url!==url);erpSaveTabs(tabs);if(was&&tabs.length)location.href=tabs[tabs.length-1].url;else erpRenderTabs()}
+function erpOpen(url,newTab=false,title=''){if(!url)return;if(newTab){let tabs=erpLoadTabs().filter(t=>t.url!==erpCleanUrl(url));tabs.push({url:erpCleanUrl(url),title:title||'شاشة',ts:Date.now()});erpSaveTabs(tabs)}location.href=url}
+function erpContextMenu(items,x,y){const menu=document.getElementById('erpGlobalContextMenu');if(!menu)return;menu.innerHTML='';items.filter(Boolean).forEach(item=>{if(item.separator){menu.appendChild(document.createElement('hr'));return}const b=document.createElement('button');b.type='button';b.className=item.danger?'danger':'';b.textContent=(item.icon?item.icon+' ':'')+item.label;b.onclick=()=>{menu.classList.remove('show');item.action?.()};menu.appendChild(b)});menu.style.left=Math.max(8,Math.min(x,innerWidth-240))+'px';menu.style.top=Math.max(8,Math.min(y,innerHeight-menu.offsetHeight-15))+'px';menu.classList.add('show')}
+document.addEventListener('contextmenu',e=>{const a=e.target.closest('a[href]');if(!a||a.closest('.erp-workspace-tabs')||a.href.startsWith('javascript:'))return;e.preventDefault();const title=(a.textContent||a.title||'السجل').trim();erpContextMenu([{icon:'↗',label:'فتح',action:()=>location.href=a.href},{icon:'▣',label:'فتح في شاشة جديدة',action:()=>erpOpen(a.href,true,title)},{icon:'□',label:'فتح في نافذة المتصفح',action:()=>window.open(a.href,'_blank')}],e.clientX,e.clientY)});
+document.addEventListener('auxclick',e=>{const a=e.target.closest('a[href]');if(a&&e.button===1){e.preventDefault();erpOpen(a.href,true,(a.textContent||'شاشة').trim())}});
+document.addEventListener('click',e=>{document.getElementById('erpGlobalContextMenu')?.classList.remove('show');const a=e.target.closest('a[href]');if(a&&e.ctrlKey&&!a.target){e.preventDefault();erpOpen(a.href,true,(a.textContent||'شاشة').trim())}});
+document.addEventListener('keydown',e=>{if((e.ctrlKey||e.metaKey)&&e.key.toLowerCase()==='k'){e.preventDefault();const s=document.querySelector('#global-search-form input[name=q]');s?.focus();s?.select()}if(e.altKey&&e.key==='ArrowLeft')history.back();if(e.altKey&&e.key==='ArrowRight')history.forward()});
+document.addEventListener('DOMContentLoaded',()=>{erpRememberPage();document.getElementById('erpBackBtn')?.addEventListener('click',()=>history.back());document.getElementById('erpForwardBtn')?.addEventListener('click',()=>history.forward());document.getElementById('erpRefreshBtn')?.addEventListener('click',()=>location.reload());document.querySelectorAll('.table tbody tr').forEach(r=>{if(r.querySelector('a[href]'))r.style.cursor='default'})});
 document.addEventListener("click",function(e){const sb=document.getElementById("erpSidebar");if(window.innerWidth<=900&&sb?.classList.contains("open")&&!sb.contains(e.target)&&!e.target.closest(".mobile-menu-btn")){sb.classList.remove("open");}});
